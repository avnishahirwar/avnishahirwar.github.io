  "defaultGuidance": {
    "summary": "Country-specific mortgage rules have not yet been verified against an official source for this market. Use this as a general repayment estimate only; confirm the applicable lending, tax, fee and eligibility rules with the local regulator and lender.",
    "rules": [
      "No country-specific down-payment, loan-to-value, affordability, tax or fee rule is asserted here.",
      "Enter the interest rate, term, payment frequency and compounding method from your lender's written offer.",
      "Local property taxes, transfer duties, insurance, subsidies, eligibility and lender charges are not automatically included."
    ],
    "sources": []
  },
  "regionalFramework": {
    "summary": "EU mortgage-credit rules provide a shared consumer-protection framework, including lender creditworthiness assessment and standardized pre-contractual information. National law, taxes, property costs and competent authorities still differ by Member State.",
    "rules": [
      "EU-level rules require lenders to assess creditworthiness before granting mortgage credit; national law and supervisory practice add country-specific requirements.",
      "Use the linked European Banking Authority directory to identify the national consumer-protection authority for this Member State.",
      "This page does not calculate local transfer taxes, registration fees, national subsidies, affordability thresholds or lender-specific terms."
    ],
    "sources": [
      [
        "European Commission: Mortgage loans and credit in the EU",
        "https://europa.eu/youreurope/citizens/consumers/financial-products-and-services/mortgages/index_en.htm"
      ],
      [
        "European Banking Authority: National consumer-protection authorities",
        "https://www.eba.europa.eu/activities/information-consumers/national-competent-authorities-consumer-protection"
      ]
    ]
  },
  "verified": {
    "IN": {
      "summary": "Reserve Bank of India guidance highlights fixed versus floating rates, benchmark resets, APR and lender fees. Housing-finance-company LTV ceilings are a separate regulated category and should not be treated as a universal down-payment rule for every lender.",
      "rules": [
        "Ask the lender whether the rate is fixed or floating, which benchmark applies, when it resets and how EMI or loan tenure can change.",
        "Compare APR and all fees, including processing, legal, valuation, documentation, switching and prepayment charges; stamp duty and registration are separate purchase costs.",
        "RBI's 2025 HFC directions set maximum LTV bands for housing finance companies: up to 90% for loans up to ₹30 lakh, 80% above ₹30 lakh to ₹75 lakh, and 75% above ₹75 lakh. These HFC-specific ceilings are not a promise of approval or a universal rule for every lender."
      ],
      "sources": [
        [
          "RBI: Home-loan borrower FAQ",
          "https://www.rbi.org.in/scripts/FAQView.aspx?Id=77"
        ],
        [
          "RBI: Floating-rate EMI loan reset FAQ (2025)",
          "https://www.rbi.org.in/commonman/Upload/English/FAQs/PDFs/FAQRFIR10012025.pdf"
        ],
        [
          "RBI: Housing Finance Company Master Directions (2025)",
          "https://www.rbi.org.in/Scripts/BS_ViewMasDirections.aspx?id=12939"
        ]
      ]
    },
    "US": {
      "summary": "US federal consumer rules include an ability-to-repay assessment for most residential mortgages and standardized Loan Estimate and Closing Disclosure documents. State, loan-program and lender terms can add differences.",
      "rules": [
        "Most lenders must make a reasonable, good-faith ability-to-repay determination using documented borrower financial information.",
        "The Loan Estimate summarizes expected loan terms and costs; the Closing Disclosure sets out final terms and closing costs and is generally due at least three business days before closing.",
        "This calculator does not estimate credit approval, mortgage insurance, property tax, homeowners association dues or state-specific closing costs unless you enter applicable amounts."
      ],
      "sources": [
        [
          "CFPB: Ability-to-repay rule",
          "https://www.consumerfinance.gov/ask-cfpb/what-is-the-ability-to-repay-rule-en-1787/"
        ],
        [
          "CFPB: Loan Estimate and Closing Disclosure documents",
          "https://www.consumerfinance.gov/ask-cfpb/what-documents-should-i-receive-before-closing-on-a-mortgage-loan-en-181/"
        ],
        [
          "US Code: Minimum standards for residential mortgage loans",
          "https://uscode.house.gov/us/usc/119-124/t15/s1639c/"
        ]
      ]
    },
    "CA": {
      "summary": "Federally regulated Canadian lenders must provide clear mortgage disclosures and an information box. The Canadian fixed-rate mortgage convention commonly uses nominal annual interest compounded semi-annually; match the actual agreement.",
      "rules": [
        "Review the mortgage information box and disclosure statement for rate, payment, term, fees and prepayment conditions.",
        "The calculator preselects semi-annual compounding for Canada, but you should confirm the exact convention and payment schedule in the lender's contract.",
        "Provincial rules, land-transfer taxes, insurance premiums and lender qualification policies are not automatically calculated."
      ],
      "sources": [
        [
          "Financial Consumer Agency of Canada: Mortgage rights and disclosures",
          "https://www.canada.ca/en/financial-consumer-agency/services/rights-responsibilities/rights-mortgages/applying-for-mortgage.html"
        ],
        [
          "FCAC: Fixed mortgage information-box example",
          "https://www.canada.ca/en/financial-consumer-agency/services/industry/bulletins/information-box-examples/credit-agreement-fixed-mortgage.html"
        ]
      ]
    },
    "GB": {
      "summary": "UK deposit sizes and affordability depend on lender and product. MoneyHelper describes 5%–20% as a typical deposit range, not a statutory minimum or guarantee; lenders apply their own affordability criteria.",
      "rules": [
        "MoneyHelper says a deposit is typically around 5%–20% of the purchase price; a larger deposit may improve available rates, but lender terms vary.",
        "Lenders assess affordability and individual circumstances; the calculator does not determine mortgage eligibility.",
        "Stamp Duty Land Tax in England and Northern Ireland, Land Transaction Tax in Wales and Land and Buildings Transaction Tax in Scotland have different rules and are not calculated here."
      ],
      "sources": [
        [
          "MoneyHelper: How much can you afford to borrow?",
          "https://www.moneyhelper.org.uk/en/homes/buying-a-home/how-much-can-you-afford-to-borrow-for-a-mortgage.html"
        ],
        [
          "MoneyHelper: Mortgage fees and buying costs",
          "https://www.moneyhelper.org.uk/en/homes/buying-a-home/estimate-your-overall-buying-and-moving-costs"
        ]
      ]
    },
    "AU": {
      "summary": "Australian home-loan comparisons use a comparison rate that combines the interest rate with most fees and charges, but excludes some government charges and conditional fees. Repayment frequency and loan features matter.",
      "rules": [
        "Compare the advertised interest rate with the comparison rate; the comparison rate includes most fees but not every government or conditional charge.",
        "Check offset/redraw features, extra repayment limits, ongoing fees, fixed-rate expiry and break costs in the lender's Key Facts Sheet and contract.",
        "The calculator does not apply state or territory transfer duty, lenders mortgage insurance or lender-specific serviceability rules."
      ],
      "sources": [
        [
          "ASIC: National Credit Code and comparison-rate explanation",
          "https://www.asic.gov.au/regulatory-resources/credit/credit-general-conduct-obligations/national-credit-code"
        ],
        [
          "Moneysmart: Choosing a home loan",
          "https://moneysmart.gov.au/home-loans/choosing-a-home-loan"
        ],
        [
          "Moneysmart: Mortgage calculator",
          "https://moneysmart.gov.au/HOME-LOANS/MORTGAGE-CALCULATOR"
        ]
      ]
    },
    "AE": {
      "summary": "The Central Bank of the UAE sets borrower-based mortgage measures including loan-to-value limits, debt-burden ratio caps, maximum finance amounts and loan terms. LTV treatment differs by borrower category and property purpose/value.",
      "rules": [
        "UAE LTV limits vary by UAE national versus expatriate, first owner-occupied home versus subsequent/investment property, and property value. Off-plan property has separate treatment.",
        "The Central Bank framework also includes debt-burden and maximum-loan-term controls; the calculator does not decide eligibility or apply a bank's full affordability assessment.",
        "Confirm the current CBUAE rule and your bank's terms before using any down-payment figure. No universal UAE deposit percentage is assumed here."
      ],
      "sources": [
        [
          "Central Bank of the UAE: Borrower-based mortgage measures",
          "https://centralbank.ae/en/our-operations/financial-stability/"
        ],
        [
          "CBUAE Rulebook: Regulations regarding mortgage loans",
          "https://rulebook.centralbank.ae/en/rulebook/regulations-regarding-mortgage-loans"
        ]
      ]
    },
    "NZ": {
      "summary": "New Zealand's Reserve Bank sets high-LVR lending speed limits for banks, not a guaranteed deposit requirement for each borrower. Banks still apply their own lending criteria.",
      "rules": [
        "Current settings allow up to 25% of new owner-occupier lending to be above 80% LVR and up to 10% of investor lending to be above 70% LVR; these are portfolio speed limits, not individual approval entitlements.",
        "The Reserve Bank reviews settings over time. Check the current RBNZ rules and the lender's own affordability assessment.",
        "The calculator does not apply DTI restrictions, first-home loan exemptions or lender-specific criteria."
      ],
      "sources": [
        [
          "Reserve Bank of New Zealand: Loan-to-value ratio restrictions",
          "https://www.rbnz.govt.nz/en/regulation-and-supervision/oversight-of-banks/standards-and-requirements-for-banks/macroprudential-policy/loan-to-value-ratio-restrictions"
        ],
        [
          "RBNZ: Understanding LVR restrictions",
          "https://www.rbnz.govt.nz/education/explainers/loan-to-value-restrictions-explained"
        ]
      ]
    },
    "SG": {
      "summary": "Singapore home purchases can incur Buyer's Stamp Duty based on the higher of purchase price or market value. Additional Buyer's Stamp Duty depends on buyer profile and property circumstances; this mortgage estimate does not calculate those taxes.",
      "rules": [
        "IRAS calculates Buyer's Stamp Duty using the purchase price or market value, whichever is higher, with progressive residential rates.",
        "Additional Buyer's Stamp Duty may also apply depending on buyer profile and property count/status; check current IRAS rules before budgeting.",
        "Mortgage financing limits and eligibility depend on property type, borrower profile and current Monetary Authority of Singapore rules; they are not inferred from this payment estimate."
      ],
      "sources": [
        [
          "IRAS: Buyer's Stamp Duty",
          "https://www.iras.gov.sg/taxes/stamp-duty/for-property/buying-or-acquiring-property/buyer%27s-stamp-duty-%28bsd%29"
        ],
        [
          "IRAS: Stamp duty rates and taxes",
          "https://www.iras.gov.sg/quick-links/tax-rates/stamp-duty"
        ]
      ]
    }
