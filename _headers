/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: frame-ancestors 'self'

/embed/*
  Content-Security-Policy: frame-ancestors *

https://friendly-calculator.pages.dev/*
  X-Robots-Tag: noindex

https://:version.friendly-calculator.pages.dev/*
  X-Robots-Tag: noindex

# Cache static assets at the edge and in browsers; HTML remains revalidated.
# Short TTL is intentional because asset URLs are not content-hashed yet.
/assets/*.css
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/assets/*.js
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/assets/*.svg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/assets/*.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/assets/*.webp
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/assets/*.jpg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/assets/*.jpeg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

